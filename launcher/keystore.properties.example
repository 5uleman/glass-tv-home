# Copy to launcher/keystore.properties (gitignored) and fill in the two passwords yourself.
# Never commit the copy: this is the only place they are read from.
#
# storeFile is the key store made outside the repository, with an absolute path, e.g.
#   keytool -genkeypair -v -keystore C:/Users/<you>/keys/glasstv-release.jks -alias glasstv \
#           -keyalg RSA -keysize 2048 -validity 10000
#
# Without this file, or with any of the four values empty, assembleRelease falls back to the
# debug key, which is what CI and a fresh clone get.
storeFile=C:/Users/<you>/keys/glasstv-release.jks
storePassword=
keyAlias=glasstv
keyPassword=
